<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rent Free Mind</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: linear-gradient(to bottom, #fff1f5, #ffe4ec, #ffd6e7);
      color: #3f2430;
      overflow-x: hidden;
    }

    .glow {
      position: fixed;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(255,182,193,0.45), transparent 70%);
      top: -200px;
      right: -150px;
      z-index: 0;
      pointer-events: none;
    }

    header {
      position: sticky;
      top: 0;
      backdrop-filter: blur(12px);
      background: rgba(255,255,255,0.4);
      border-bottom: 1px solid rgba(255,192,203,0.4);
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 10;
    }

    .logo {
      font-size: 2rem;
      font-weight: 800;
      color: #ff5c93;
    }

    .logo span {
      color: #7f4961;
    }

    .hero {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 120px 8% 80px;
    }

    .tag {
      display: inline-block;
      padding: 12px 22px;
      background: rgba(255,255,255,0.55);
      border-radius: 999px;
      border: 1px solid #ffc1d6;
      color: #b14f78;
      margin-bottom: 30px;
      font-size: 0.95rem;
    }

    h1 {
      font-size: clamp(3rem, 8vw, 6rem);
      line-height: 1;
      margin-bottom: 25px;
    }

    .hero p {
      max-width: 850px;
      margin: auto;
      font-size: 1.15rem;
      color: #6e4a5b;
      line-height: 1.8;
    }

    .buttons {
      margin-top: 45px;
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .btn {
      padding: 16px 32px;
      border-radius: 18px;
      text-decoration: none;
      font-weight: 600;
      transition: 0.3s ease;
    }

    .primary {
      background: #ff77a8;
      color: white;
      box-shadow: 0 10px 30px rgba(255,119,168,0.3);
    }

    .primary:hover {
      transform: translateY(-4px);
    }

    .secondary {
      border: 1px solid #ff9bbf;
      background: rgba(255,255,255,0.5);
      color: #b14f78;
    }

    .plans {
      position: relative;
      z-index: 2;
      padding: 50px 8% 100px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
    }

    .card {
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255,192,203,0.4);
      border-radius: 35px;
      padding: 40px 30px;
      box-shadow: 0 10px 35px rgba(255,182,193,0.2);
      transition: 0.3s ease;
    }

    .card:hover {
      transform: translateY(-8px);
    }

    .featured {
      transform: scale(1.03);
      border: 2px solid #ff77a8;
    }

    .card h2 {
      font-size: 2rem;
      margin-bottom: 15px;
    }

    .price {
      font-size: 3rem;
      color: #ff5c93;
      font-weight: 800;
      margin-bottom: 25px;
    }
